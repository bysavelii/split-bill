---
import type { InferGetStaticPropsType } from "astro";
import "../style.css";
import HowItWorks from "../components/how-it-works.astro";
import PageFooter from "../components/page-footer.astro";
import PageHead from "../components/page-head.astro";
import { DICTIONARIES } from "../i18n/dictionaries";
import { buildRouteParameter, LOCALES } from "../i18n/locales";
import { buildPageMetadata } from "../seo/page-metadata";
import { buildSiteRoot } from "../seo/site-root";
import { App } from "../ui/app";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    // The root page has no path segment.
    params: { locale: buildRouteParameter(locale) },
    props: { locale },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;
const messages = DICTIONARIES[locale];
const siteRoot = buildSiteRoot(Astro.site, import.meta.env.BASE_URL);
const metadata = buildPageMetadata({ locale, siteRoot });
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead metadata={metadata} />
  </head>
  <body>
    <main id="app">
      <App client:load locale={locale} />
      <HowItWorks messages={messages.howItWorks} />
    </main>
    <PageFooter messages={messages.footer} />
  </body>
</html>
